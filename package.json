{
  "name": "enso",
  "version": "1.49.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"wrangler dev --port 8787\" \"vite --config frontend/vite.config.ts\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:lan": "wrangler dev --ip 0.0.0.0 --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p home/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply enso --local",
    "db:migrate:remote": "wrangler d1 migrations apply enso --remote",
    "build": "vite build --config frontend/vite.config.ts",
    "build:home": "esbuild home/captions-helper.ts --bundle --platform=node --format=esm --target=node24 --outfile=home/dist/captions-helper.mjs",
    "deploy": "npm run build && wrangler deploy",
    "arch:audit": "tsx scripts/arch-audit.ts",
    "seed:dev": "node scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@block65/webcrypto-web-push": "2.0.0",
    "hono": "^4.13.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "0.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  }
}
