# Home Reminder Calendar — Local Development Secrets
# Copy this file to .env and fill in the values. Never commit .env.

# Home Assistant long-lived access token (from HAOSDOJO)
HA_TOKEN=your-ha-long-lived-token-here

# JWT secret for signing tokens (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-jwt-secret-here

# Webhook secret for HA ↔ app communication
WEBHOOK_SECRET=your-webhook-secret-here
